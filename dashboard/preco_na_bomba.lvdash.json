{
  "datasets": [
    {
      "name": "ds_precos",
      "displayName": "Preços",
      "queryLines": [
        "SELECT data, produto, regiao, uf, municipio, bandeira, cnpj, valor_venda, valor_venda_real\n",
        "FROM preco_na_bomba.gold.vw_precos"
      ]
    },
    {
      "name": "ds_bandeiras",
      "displayName": "Preços das maiores bandeiras",
      "queryLines": [
        "WITH maiores AS (\n",
        "  SELECT bandeira FROM preco_na_bomba.gold.dim_posto WHERE ativo\n",
        "  GROUP BY bandeira ORDER BY COUNT(*) DESC LIMIT 8\n",
        ")\n",
        "SELECT v.data, v.produto, v.uf,\n",
        "       CASE WHEN v.bandeira = 'BRANCA' THEN 'BRANCA (SEM BANDEIRA)' ELSE v.bandeira END AS bandeira,\n",
        "       v.valor_venda\n",
        "FROM preco_na_bomba.gold.vw_precos v\n",
        "JOIN maiores m ON v.bandeira = m.bandeira"
      ]
    },
    {
      "name": "ds_trocas",
      "displayName": "Trocas de bandeira (SCD Tipo 2)",
      "queryLines": [
        "WITH versoes AS (\n",
        "  SELECT cnpj, revenda, uf, municipio, bandeira, data_inicio,\n",
        "         LAG(bandeira) OVER (PARTITION BY cnpj ORDER BY data_inicio) AS bandeira_anterior\n",
        "  FROM preco_na_bomba.gold.dim_posto\n",
        ")\n",
        "SELECT data_inicio AS data_troca, uf, municipio, revenda, cnpj, bandeira_anterior, bandeira AS bandeira_nova\n",
        "FROM versoes\n",
        "WHERE bandeira_anterior IS NOT NULL AND bandeira_anterior <> bandeira\n",
        "ORDER BY data_troca DESC"
      ]
    }
  ],
